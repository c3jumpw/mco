{
  "name": "ramp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/guide/check.mjs && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "build:guide": "vite build -c vite.guide.config.ts && cp -r public/guide-media dist-guide/ && mv dist-guide/guide.html dist-guide/index.html",
    "guide:check": "node tools/guide/check.mjs",
    "guide:shots": "node tools/guide/run.cjs",
    "guide:preview": "vite --config tools/guide/vite.config.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "engines": {
    "node": "22.x"
  }
}
