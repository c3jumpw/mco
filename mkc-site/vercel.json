{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/projects/dispatch-it",
      "destination": "https://mambaykanu.com/projects/dispatch-it",
      "permanent": true
    },
    {
      "source": "/projects/dayforge",
      "destination": "https://mambaykanu.com/projects/dayforge",
      "permanent": true
    },
    {
      "source": "/projects/contentflow",
      "destination": "https://mambaykanu.com/projects/contentflow",
      "permanent": true
    },
    {
      "source": "/projects/my-pd",
      "destination": "https://mambaykanu.com/projects/my-pd",
      "permanent": true
    },
    {
      "source": "/projects/circuit-book",
      "destination": "https://mambaykanu.com/projects/circuit-book",
      "permanent": true
    },
    {
      "source": "/projects/pingpath",
      "destination": "https://mambaykanu.com/projects/pingpath",
      "permanent": true
    },
    {
      "source": "/projects/halodeck",
      "destination": "https://mambaykanu.com/projects/halodeck",
      "permanent": true
    }
  ]
}
